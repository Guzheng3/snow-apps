# EditorConfig 配置
# https://editorconfig.org

# 顶级配置文件
root = true

# 所有文件的默认配置
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# JavaScript/TypeScript 文件
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_style = tab
indent_size = 2

# JSON 文件
[*.json]
indent_style = tab
indent_size = 2

# YAML 文件
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown 文件
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# Rust 文件
[*.rs]
indent_style = tab
indent_size = 4

# TOML 文件
[*.toml]
indent_style = space
indent_size = 2

# 配置文件
[{package.json,tsconfig.json}]
indent_style = tab
indent_size = 2

