{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "snow-apps",
  "version-semver": "0.1.0",
  "builtin-baseline": "ffc071e0c08432c60c9b64f00334c0227667931b",
  "dependencies": [
    "ffmpeg",
    "giflib",
    { "name": "libheif", "default-features": false, "features": ["aom"] },
    "libjpeg-turbo",
    "libjxl",
    "libwebp",
    { "name": "libpng", "features": ["apng"] },
    "lunasvg",
    "onnxruntime",
    { "name": "opencv4", "features": ["contrib", "world"] },
    "openexr",
    "vulkan-headers"
  ],
  "features": {
    "full-codecs": {
      "description": "Enable the complete Snow Image codec profile.",
      "dependencies": [
        "giflib",
        "libjpeg-turbo",
        "libjxl",
        "libwebp",
        { "name": "libheif", "default-features": false, "features": ["aom", "hevc"] },
        "lunasvg",
        "openexr"
      ]
    }
  }
}
